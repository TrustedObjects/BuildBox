function _project {
	local line

	# In the container, 'project' only handles 'goto' (see settings/zsh/.zshrc):
	# every other project operation is a 'bbx project' subcommand
	_arguments -C \
		"1: :(goto)" \
		"*::arg:->args"

	case $line[1] in
	goto)
		_project_goto
		;;
	esac
}

function _project_goto {
	_arguments -C \
		"1: :(-p)"
}
